{
  "listeners": [
    { "address": "0.0.0.0", "port": 8080, "https": false }
  ],
  "app": {
    "log": { "log_level": "INFO" }
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "user": "diag",
      "passwd": "123456",
      "dbname": "diag_agent",
      "connection_number": 4
    }
  ],
  "agent": {
    "max_steps": 10,
    "max_retries": 3,
    "llm": {
      "backend": "mock",
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:7b",
      "api_key": "",
      "timeout_ms": 30000,
      "garbage_first": false
    }
  },
  "redis": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 6379,
    "password": "",
    "db": 0
  },
  "session": {
    "key_prefix": "diag:session:",
    "ttl_seconds": 3600,
    "truncate": {
      "max_tokens": 4096,
      "keep_recent": 4,
      "chars_per_token": 4
    }
  },
  "tools": {
    "metric": { "backend": "mock", "slow": true },
    "log":    { "backend": "mock" },
    "case":   { "backend": "mock" }
  },
  "executor": {
    "timeout_ms": 5000
  },
  "storage": {
    "backend": "mock"
  },
  "mq": {
    "backend": "mock",
    "host": "127.0.0.1",
    "port": 5672,
    "user": "guest",
    "password": "guest",
    "slow_tasks_queue": "diag.slow-tasks",
    "slow_results_queue": "diag.slow-results",
    "timeout_ms": 30000
  },
  "aggregator": {
    "weights": { "query_metric": 0.3, "query_log": 0.3, "search_case": 0.4 },
    "thresholds": { "low": 0.4, "high": 0.7 }
  }
}
